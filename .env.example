# 公開URL（末尾スラッシュなし）。設定すると canonical / OGP / sitemap.xml を出力します
VITE_SITE_URL=
# Google AdSense のクライアントID（例: ca-pub-xxxxxxxxxxxxxxxx）。未設定なら広告枠は表示されません
VITE_ADSENSE_CLIENT=
# AdSense の広告ユニットID（data-ad-slot）。未設定ならユニット広告は入りません
VITE_ADSENSE_SLOT=
# お問い合わせの送信先メールアドレス。未設定ならフォームは「準備中」表示になります
VITE_CONTACT_EMAIL=
# 1 にすると検索エンジンに載せない（試験公開用。本番では空にする）
VITE_NOINDEX=

# ---- クラウド保存（Supabase）----
# 未設定ならクラウド保存は「準備中」表示になり、ローカル保存だけで動きます。
# Supabase の Project Settings > API の Project URL と anon（public）キー。
# anon キーはブラウザに公開される前提の値です。service_role キーは絶対にここへ書かないこと
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- 商品紹介（アフィリエイト）----
# 商品カタログ（JSON）の場所。例: /products.json（public/products.json を置く）。未設定なら商品紹介は表示せず、読み込みもしない
VITE_PRODUCT_CATALOG_URL=

# ---- 開発・テスト専用 ----
# 1 にすると、テスト用ビルド（vite build --mode e2e）でだけ「模擬クラウド」を使う。本番ビルドでは無視される
VITE_DEV_MOCK_CLOUD=
